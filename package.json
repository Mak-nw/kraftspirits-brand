{
  "name": "site-brand",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5200 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 5200 --strictPort",
    "qa": "node tools/qa/run.mjs",
    "qa:full": "node tools/qa/run.mjs --full",
    "qa:check-ds": "node tools/qa/check-ds.mjs",
    "qa:links": "node tools/qa/links.mjs",
    "qa:links:en": "node tools/qa/links.mjs --pages en/index,en/about,en/catalog,en/cart,en/faq,en/contacts",
    "qa:i18n": "node tools/qa/i18n.mjs",
    "qa:states": "node tools/qa/states.mjs",
    "qa:arch": "node tools/qa/arch.mjs",
    "qa:arch:cocktails": "node tools/qa/arch.mjs --page cocktails",
    "qa:cls": "node tools/qa/cls.mjs",
    "qa:hscroll": "node tools/qa/hscroll.mjs",
    "qa:resp": "node tools/qa/responsive.mjs",
    "qa:resp-ds": "node tools/qa/check-ds.mjs --rules D3,D4,D13,D17 --widths 390,768,1024,2560 --scrollbar none",
    "qa:about-geom": "node tools/qa/about-geom.mjs",
    "qa:ink": "node tools/qa/ink-align.mjs",
    "qa:grid": "node tools/qa/check-ds.mjs --rules D12 --widths 1200,1440,1728,1920 --scrollbar none",
    "qa:img-contrast": "node tools/qa/check-ds.mjs --rules D14 --widths 1200,1440,1728,1920 --scrollbar both",
    "qa:header": "node tools/qa/check-ds.mjs --rules D15 --widths 1200,1440,1728,1920 --scrollbar both",
    "qa:d18": "node tools/qa/check-ds.mjs --rules D18 --widths 1200,1440,1728,1920 --scrollbar both",
    "qa:d19": "node tools/qa/check-ds.mjs --rules D19 --widths 1200,1440,1728,1920 --scrollbar both",
    "qa:lp": "node tools/qa/lp-contract.mjs",
    "qa:lp-stack": "node tools/qa/lp-stack.mjs",
    "qa:lp-cols": "node tools/qa/lp-cols.mjs",
    "qa:hero-btn": "node tools/qa/hero-btn.mjs",
    "qa:overlay-grid": "node tools/qa/overlay-grid.mjs"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "html2canvas": "^1.4.1",
    "puppeteer-core": "^25.14.0",
    "vite": "^8.3.3"
  },
  "dependencies": {
    "lottie-web": "^5.13.0",
    "maplibre-gl": "6.14.0"
  }
}

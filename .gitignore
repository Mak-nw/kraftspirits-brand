# Залежності та результат збірки (dist відтворюється через `npm ci && npm run build`)
node_modules/
dist/

# Кеш Vite і логи
.vite/
*.log

# Системні файли macOS/редакторів
.DS_Store
*.swp
*~

# Локальні змінні середовища (секрети не комітимо; BASE_PATH задається в CI, а не в файлі)
.env
.env.*

# Тимчасові скриншоти й бекапи, що випадають у корінь проєкту (public/ сюди не входить)
/*.png
*.bak
*.orig

# Робочі scratch-каталоги
scratch/
screenshots/

# Внутрішні інструкції для агентів (лишаються лише локально)
CLAUDE.md
/tools/qa/.out/

# Службові pid-файли dev-серверів і тимчасові скрипти
.dev-*.pid
tools/_t.mjs
